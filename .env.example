# Supabase project Connect panel: publishable values only. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set true only after the reminder worker, sender domain, and staging checks are complete.
VITE_COMMIT_EMAIL_AVAILABLE=false
# Enable only after an approved private OCR endpoint and deployed parse-evidence function exist.
VITE_COMMIT_OCR_AVAILABLE=false
VITE_COMMIT_OCR_PROCESSOR_NAME=
VITE_COMMIT_OCR_PROCESSOR_REGION=
# Public VAPID key for opt-in PWA push. Private key belongs only in Edge secrets.
VITE_COMMIT_VAPID_PUBLIC_KEY=
# Turn on only after provider review, credentials, token encryption and staging checks.
VITE_COMMIT_GMAIL_AVAILABLE=false
VITE_COMMIT_PLAID_AVAILABLE=false
